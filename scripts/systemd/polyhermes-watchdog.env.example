# Copy to /etc/polyhermes/watchdog.env and keep the real webhook out of Git.
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
# Or use an app bot instead of a webhook:
# FEISHU_APP_ID=cli_REPLACE_ME
# FEISHU_APP_SECRET=REPLACE_ME
# FEISHU_RECEIVE_ID=oc_REPLACE_ME
WATCHDOG_FAILURE_THRESHOLD=3
WATCHDOG_REMINDER_SECONDS=1800
WATCHDOG_AUTO_RESTART_APP=true
WATCHDOG_APP_MEMORY_WARNING_PERCENT=75
POLYHERMES_PUBLIC_URL=https://polyhermes.66-135-16-16.sslip.io/
