{
  "manifest_version": 3,
  "name": "PolyHermes Future BTC 5m 助手",
  "version": "0.7.3",
  "minimum_chrome_version": "116",
  "description": "按项目策略进入 BTC 5 分钟或 15 分钟（反 1 小时）市场填 $1；热门价 ≥60¢、页面与 Polymarket 盘口价差 ≤3¢ 且在准备价 ±5¢ 内时自动点击一次买入。",
  "host_permissions": ["http://127.0.0.1/*"],
  "permissions": ["power", "debugger"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://future.news/*"],
    "js": ["content.js", "buy_once.js"],
    "run_at": "document_idle"
  }]
}
