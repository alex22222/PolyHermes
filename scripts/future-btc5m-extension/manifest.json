{
  "manifest_version": 3,
  "name": "PolyHermes Future BTC 5m 助手",
  "version": "0.2.4",
  "description": "自动进入当前 BTC 五分钟市场，上报只读票据预检并显示 $1 草稿；买入由用户完成。",
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://future.news/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
