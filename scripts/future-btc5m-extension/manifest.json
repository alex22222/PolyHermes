{
  "manifest_version": 3,
  "name": "PolyHermes Future BTC 5m 助手",
  "version": "0.6.6",
  "minimum_chrome_version": "116",
  "description": "自动进入当前 BTC 五分钟市场；开启自动票据时选择按钮数字较大的一方并填入 $1；热门价 ≥60¢、页面与 Polymarket 盘口价差 ≤3¢ 且在准备价 ±5¢ 内时自动点击一次买入。",
  "host_permissions": ["http://127.0.0.1/*"],
  "permissions": ["power"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://future.news/*"],
    "js": ["content.js", "buy_once.js"],
    "run_at": "document_idle"
  }]
}
